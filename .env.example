# Production-ready env examples

Copy to .env and update for your environment.

# Postgres
DATABASE_URL="postgresql://chagga:changeme@db:5432/chagga"

# JWT secrets
JWT_ACCESS_SECRET="replace-with-long-random-secret-for-access"
JWT_REFRESH_SECRET="replace-with-long-random-secret-for-refresh"

# Server
PORT=3000
NODE_ENV=development

# Redis (for BullMQ)
REDIS_URL=redis://redis:6379

# S3 (optional - used if you switch uploads to S3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_KEY=
S3_SECRET=

